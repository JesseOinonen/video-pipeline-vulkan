<mxfile host="app.diagrams.net" type="device">
  <diagram name="Stage 1 - setup" id="stage1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Vulkan stage 1: instance -&gt; device -&gt; queue -&gt; command buffer" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;VkInstance&lt;/b&gt;&lt;br&gt;vkCreateInstance()&lt;br&gt;&lt;i&gt;connection to the loader&lt;br&gt;validation layer is enabled HERE, nowhere else&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;VkPhysicalDevice&lt;/b&gt;&lt;br&gt;vkEnumeratePhysicalDevices() + pick&lt;br&gt;&lt;i&gt;description of installed hardware&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;queue family index&lt;/b&gt; (uint32_t)&lt;br&gt;vkGetPhysicalDeviceQueueFamilyProperties()&lt;br&gt;&lt;i&gt;which engine group runs compute&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;VkDevice&lt;/b&gt;&lt;br&gt;vkCreateDevice()&lt;br&gt;&lt;i&gt;open session with the chosen GPU&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;VkQueue&lt;/b&gt;&lt;br&gt;vkGetDeviceQueue()&lt;br&gt;&lt;i&gt;where work is submitted&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;VkCommandPool&lt;/b&gt;&lt;br&gt;vkCreateCommandPool()&lt;br&gt;&lt;i&gt;memory for recorded commands&lt;br&gt;one family, one thread&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;VkCommandBuffer&lt;/b&gt;&lt;br&gt;vkAllocateCommandBuffers()&lt;br&gt;&lt;i&gt;where commands are recorded&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="640" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="buffer + memory, record, submit, fence&lt;br&gt;&lt;i&gt;next stage&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="n4" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n5" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;The verb decides the cleanup&lt;/b&gt;&lt;br&gt;&lt;b&gt;blue&lt;/b&gt; vkCreate* -&gt; must be destroyed&lt;br&gt;&lt;b&gt;green&lt;/b&gt; vkGet*/vkEnumerate* -&gt; never destroyed&lt;br&gt;&lt;b&gt;purple&lt;/b&gt; vkAllocate* -&gt; freed with its pool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pA" value="&lt;b&gt;Pattern A - create&lt;/b&gt;&lt;br&gt;1. VkXCreateInfo info{};&lt;br&gt;2. info.sType = VK_STRUCTURE_TYPE_X&lt;br&gt;3. fill fields (small infos nest into big ones)&lt;br&gt;4. vkCreateX(&lt;b&gt;parent&lt;/b&gt;, &amp;amp;info, nullptr, &amp;amp;out)&lt;br&gt;5. check == VK_SUCCESS&lt;br&gt;&lt;i&gt;instance, device, command pool, and everything after&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="190" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="pB" value="&lt;b&gt;Pattern B - enumerate&lt;/b&gt;&lt;br&gt;1. call with count ptr + nullptr for data&lt;br&gt;2. size a std::vector to the count&lt;br&gt;3. call again with vector.data()&lt;br&gt;&lt;i&gt;layers, physical devices, queue families&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="parent" value="&lt;b&gt;Which handle is the first argument?&lt;/b&gt;&lt;br&gt;The &lt;b&gt;parent&lt;/b&gt; - the object it dies with.&lt;br&gt;Check the destroy call: vkDestroyCommandPool&lt;br&gt;(&lt;b&gt;device&lt;/b&gt;, pool) -&gt; so device is also first on create.&lt;br&gt;&lt;i&gt;VkPhysicalDevice is nobody's parent: queries and&lt;br&gt;vkCreateDevice only.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="490" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="td" value="&lt;b&gt;Teardown = reverse of creation&lt;/b&gt;&lt;br&gt;&lt;br&gt;vkDestroyCommandPool(device, commandPool)&lt;br&gt;vkDestroyDevice(device)&lt;br&gt;vkDestroyInstance(instance)&lt;br&gt;&lt;br&gt;&lt;i&gt;VkPhysicalDevice, VkQueue and VkCommandBuffer&lt;br&gt;are missing on purpose - two were never created,&lt;br&gt;the third goes away with its pool.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="330" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
